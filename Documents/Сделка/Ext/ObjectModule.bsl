Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если Статус = Перечисления.СтатусыСделки.ПустаяСсылка() Тогда
        Статус = Перечисления.СтатусыСделки.Новая;
    КонецЕсли;
	
    Сумма = 0;

    Для Каждого СтрокаТовары Из Товары Цикл
        Сумма = Сумма + СтрокаТовары.Количество * СтрокаТовары.Цена;
    КонецЦикла;

    Если Сумма <= 0 Тогда
        Сообщить("Сумма сделки должна быть больше нуля");
        Отказ = Истина;
    КонецЕсли;

    Если Клиент = Справочники.Клиенты.ПустаяСсылка() Тогда
        Сообщить("Выберите клиента для сделки");
        Отказ = Истина;
    КонецЕсли;

КонецПроцедуры
